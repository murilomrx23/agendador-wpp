# Credenciais do Telegram (https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# String de sessão gerada pelo `npm run login` (login com SEU número de usuário)
TELEGRAM_SESSION=

# Canais oficiais a monitorar (separados por vírgula).
# Aceita username público (com/sem @) OU link de convite privado (t.me/+hash).
# Canais oficiais já configurados:
#   Shopee (público):        afiliadosshopeebroficial
#   Mercado Livre (privado): https://t.me/+iUwhewgG9bg3N2Yx
TELEGRAM_CHANNELS=afiliadosshopeebroficial, https://t.me/+iUwhewgG9bg3N2Yx

# Endpoint de ingestão do Worker e o token que o protege
INGEST_URL=https://ofertas-bot.SEU-SUBDOMINIO.workers.dev/api/coupons/ingest
INGEST_TOKEN=troque-por-um-token-secreto
