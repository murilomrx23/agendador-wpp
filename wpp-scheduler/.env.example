# Porta do painel
PORT=8080

# Senha simples para proteger o painel (opcional, mas recomendado se ficar exposto na internet).
# Se definida, o painel pede essa senha (Basic Auth: usuário "admin").
DASHBOARD_PASSWORD=

# Intervalo mínimo entre envios, em segundos (evita parecer spam). Padrão: 8
MIN_SEND_GAP_SECONDS=8
