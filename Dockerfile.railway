# Dockerfile usado pelo Railway ao implantar a RAIZ do repositório.
# Ele constrói apenas a pasta wpp-scheduler (o agendador de WhatsApp),
# assim você NÃO precisa configurar "Root Directory" no painel do Railway.
FROM node:20-slim

WORKDIR /app

# Instala só as dependências de produção do agendador
COPY wpp-scheduler/package*.json ./
RUN npm install --omit=dev

# Copia o código do agendador
COPY wpp-scheduler/ ./

# DATA_DIR é onde a sessão do WhatsApp (auth/) e a fila de mensagens ficam.
# Monte um VOLUME persistente em /data no Railway.
ENV DATA_DIR=/data
ENV PORT=8080
EXPOSE 8080

CMD ["node", "src/server.js"]
